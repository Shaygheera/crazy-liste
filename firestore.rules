rules_version = '2';
// Règles Firestore de Crazy Liste : un compte connecté ne lit et n'écrit que sous users/<son identifiant>/.
// Tout le reste de la base est refusé, y compris pour les visiteurs non connectés.
// Verrouillage conseillé après ta première connexion : remplace la condition par
//   request.auth != null && request.auth.uid == uid && uid == "<ton identifiant Firebase>"
// pour qu'aucun autre compte Google ne puisse même créer un espace dans ton projet.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
